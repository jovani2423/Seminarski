@model RentACar.Presentation.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Prijava";
}

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-header">
            <div class="auth-logo">R</div>
            <h1>Dobrodošli nazad</h1>
            <p>Prijavite se na svoj RentACar nalog.</p>
        </div>

        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">
                    Email adresa
                </label>
                <input asp-for="Email"
                       class="form-control auth-input"
                       placeholder="Unesite email adresu" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">
                    Lozinka
                </label>
                <input asp-for="Password"
                       class="form-control auth-input"
                       placeholder="Unesite lozinku" />
                <span asp-validation-for="Password"
                      class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe"
                       class="form-check-input" />
                <label asp-for="RememberMe"
                       class="form-check-label">
                    Zapamti me
                </label>
            </div>

            <button type="submit"
                    class="btn btn-gold auth-submit">
                Prijavite se
            </button>
        </form>

        <div class="auth-footer">
            Nemate nalog?
            <a asp-controller="Account"
               asp-action="Register">
                Registrujte se
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
