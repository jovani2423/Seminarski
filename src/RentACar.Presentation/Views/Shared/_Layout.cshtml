
<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentACar</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RentACar.Presentation.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rent-navbar shadow-sm">
            <div class="container">
                <a class="navbar-brand rent-brand"
                   asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">R</span>
                    Rent<span>ACar</span>
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Otvori navigaciju">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home" asp-action="Index">
                                Početna
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Car" asp-action="Index">
                                Automobili
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Reservation"
                                   asp-action="MyReservations">
                                    Moje rezervacije
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Dashboard"
                                       asp-action="Index">
                                        Kontrolna tabla
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Reservation"
                                       asp-action="AllReservations">
                                        Sve rezervacije
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-lg-center gap-2 flex-column flex-lg-row">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="navbar-text text-light me-lg-2">
                                Zdravo, @User.Identity.Name
                            </span>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">
                                <button type="submit"
                                        class="btn btn-outline-gold btn-sm">
                                    Odjavite se
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-gold btn-sm"
                               asp-controller="Account"
                               asp-action="Login">
                                Prijava
                            </a>

                            <a class="btn btn-gold btn-sm"
                               asp-controller="Account"
                               asp-action="Register">
                                Registracija
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

   
    <footer class="rent-footer">
        <div class="container d-flex flex-column flex-md-row
            justify-content-between align-items-center">

            <span class="rent-footer-copyright">
                &copy; 2026 RentACar. Sva prava zadržana.
            </span>

            <div class="rent-footer-links">
                <a asp-controller="Home" asp-action="About">O nama</a>
                <a asp-controller="Home" asp-action="Contact">Kontakt</a>
                <a asp-controller="Home" asp-action="Privacy">Politika privatnosti</a>
            </div>

        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
