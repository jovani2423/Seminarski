@model RentACar.Presentation.ViewModels.ReservationViewModel

@{
    ViewData["Title"] = "Rezervacija automobila";
}

<div class="reservation-page">
    <div class="reservation-card">
        <div class="reservation-header">
            <div class="reservation-icon">R</div>
            <span class="reservation-label">RENT A CAR</span>
            <h1>Rezervišite automobil</h1>
            <p>Izaberite automobil i datume za Vaše sledeće putovanje.</p>
        </div>

        <form asp-controller="Reservation"
              asp-action="Create"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger validation-summary mb-3"></div>

            <div class="mb-4">
                <label asp-for="CarId" class="form-label">
                    Izaberite automobil
                </label>

                <select asp-for="CarId"
                        asp-items="ViewBag.AvailableCars"
                        class="form-select reservation-input">
                    <option value="">-- Izaberite automobil --</option>
                </select>

                <span asp-validation-for="CarId"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="StartDate" class="form-label">
                    Datum preuzimanja
                </label>

                <input asp-for="StartDate"
                       type="date"
                       class="form-control reservation-input"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                <span asp-validation-for="StartDate"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="EndDate" class="form-label">
                    Datum vraćanja
                </label>

                <input asp-for="EndDate"
                       type="date"
                       class="form-control reservation-input"
                       min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />

                <span asp-validation-for="EndDate"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-gold reservation-submit">
                Potvrdite rezervaciju
            </button>

            <a asp-controller="Car"
               asp-action="Index"
               class="btn btn-outline-secondary reservation-cancel">
                Odustanite
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
