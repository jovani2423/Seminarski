@{
    ViewData["Title"] = "O nama";
}

<section class="about-hero">
    <div class="about-hero-content">
        <span class="about-eyebrow">RENTACAR</span>

        <h1>O NAMA</h1>

        <p>
            Saznajte više o nama.
        </p>

    </div>
</section>

<section class="about-intro">
    <div class="about-section-heading">
        <span class="about-eyebrow">UPOZNAJTE NAS</span>
        <h2>Ko smo mi?</h2>
        <div class="about-heading-line"></div>
    </div>

    <p>
        RentACar je aplikacija namenjena jednostavnom pretraživanju
        i rezervaciji automobila. Korisnicima pruža pregled dostupnih
        vozila, informacije o cenama i mogućnost upravljanja
        sopstvenim rezervacijama.
    </p>

    <p>
        Naš cilj je da proces izbora i rezervacije vozila bude
        jednostavan, pregledan i prilagođen potrebama korisnika.
    </p>
</section>

<section class="about-features">
    <div class="about-section-heading">
        <span class="about-eyebrow">ZAŠTO RENTACAR?</span>
        <h2>Jednostavno do željenog automobila</h2>
        <div class="about-heading-line"></div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-6 col-lg-3">
            <div class="about-feature-card">
                <div class="about-feature-icon">
                    <i class="bi bi-car-front"></i>
                </div>
                <h5>Raznovrsna ponuda</h5>
                <p>
                    Pregledajte dostupne automobile i pronađite
                    vozilo koje odgovara Vašim potrebama.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="about-feature-card">
                <div class="about-feature-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <h5>Jednostavne rezervacije</h5>
                <p>
                    Rezervišite željeni automobil na jednostavan
                    i pregledan način.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="about-feature-card">
                <div class="about-feature-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h5>Preglednost</h5>
                <p>
                    Na jednom mestu pratite informacije o
                    automobilima i svojim rezervacijama.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="about-feature-card">
                <div class="about-feature-icon">
                    <i class="bi bi-clock"></i>
                </div>
                <h5>Ušteda vremena</h5>
                <p>
                    Brzo pronađite informacije koje su Vam
                    potrebne za izbor vozila.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="about-mission">
    <div class="about-mission-icon">
        <i class="bi bi-bullseye"></i>
    </div>

    <div>
        <span class="about-eyebrow">NAŠA MISIJA</span>
        <h2>Jednostavno, pregledno i dostupno.</h2>
        <p>
            Želimo da korisnicima pružimo prijatno iskustvo
            prilikom pretraživanja, izbora i rezervacije automobila.
        </p>
    </div>
</section>

