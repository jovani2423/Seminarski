@model RentACar.Presentation.ViewModels.MaintenanceRecordViewModel

@{
    ViewData["Title"] = "Izmena održavanja";
}

<div class="branch-form-page">

    <div class="branch-form-header">
        <a asp-controller="MaintenanceRecord"
           asp-action="Index"
           class="branch-form-back">
            <i class="bi bi-arrow-left"></i>
            Nazad na održavanje
        </a>

        <div class="branch-form-title">
            <div class="branch-form-icon">
                <i class="bi bi-pencil-square"></i>
            </div>
            <div>
                <h1>Izmena održavanja</h1>
                <p>Izmenite podatke o servisiranju automobila.</p>
            </div>
        </div>
    </div>

    <div class="branch-form-card">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="branch-form-section">
                <h4>Podaci o održavanju</h4>

                <div class="mb-3">
                    <label asp-for="CarId" class="branch-form-label">
                        Automobil
                    </label>

                    <select asp-for="CarId"
                            asp-items="Model.Cars"
                            class="branch-form-input">
                        <option value="">Izaberite automobil</option>
                    </select>

                    <span asp-validation-for="CarId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaintenanceDate"
                           class="branch-form-label">
                        Datum održavanja
                    </label>

                    <input asp-for="MaintenanceDate"
                           type="date"
                           class="branch-form-input" />

                    <span asp-validation-for="MaintenanceDate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="branch-form-label">
                        Opis radova
                    </label>

                    <textarea asp-for="Description"
                              class="branch-form-input"
                              rows="4"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Cost"
                           class="branch-form-label">
                        Trošak (RSD)
                    </label>

                    <input asp-for="Cost"
                           type="number"
                           step="0.01"
                           min="0"
                           class="branch-form-input" />

                    <span asp-validation-for="Cost"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Status"
                           class="branch-form-label">
                        Status održavanja
                    </label>

                    <select asp-for="Status"
                            asp-items="Model.Statuses"
                            class="branch-form-input">
                        <option value="">Izaberite status</option>
                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="branch-form-divider"></div>

            <div class="branch-form-actions">
                <a asp-action="Index"
                   class="branch-cancel-btn">
                    Otkažite
                </a>

                <button type="submit"
                        class="branch-save-btn">
                    <i class="bi bi-check-lg"></i>
                    Sačuvajte izmene
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
