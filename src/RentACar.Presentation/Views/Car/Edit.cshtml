@model RentACar.Presentation.ViewModels.CarViewModel

@{
    ViewData["Title"] = "Izmena automobila";
}

<div class="car-form-page">
    <div class="car-form-header">
        <a asp-controller="Car" asp-action="Index" class="car-back-link">
            Nazad na automobile
        </a>

        <div class="car-form-heading">
            <div class="car-form-icon">
                <span class="car-edit-symbol">✎</span>
            </div>
            <div>
                <span class="car-form-subtitle">ADMINISTRACIJA VOZILA</span>
                <h1>Izmena automobila</h1>
                <p>Izmenite podatke o automobilu i sačuvajte promene.</p>
            </div>
        </div>
    </div>

    <div class="car-form-card">
        <form asp-controller="Car" asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="car-form-section-title">
                Osnovne informacije
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Brand" class="form-label">
                        Marka automobila
                    </label>
                    <input asp-for="Brand"
                           class="form-control car-form-input" />
                    <span asp-validation-for="Brand"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Model" class="form-label">
                        Model automobila
                    </label>
                    <input asp-for="Model"
                           class="form-control car-form-input" />
                    <span asp-validation-for="Model"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Year" class="form-label">
                        Godište
                    </label>
                    <input asp-for="Year"
                           type="number"
                           class="form-control car-form-input" />
                    <span asp-validation-for="Year"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="RegistrationNumber" class="form-label">
                        Registraciona oznaka
                    </label>
                    <input asp-for="RegistrationNumber"
                           class="form-control car-form-input" />
                    <span asp-validation-for="RegistrationNumber"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="car-form-divider"></div>

            <div class="car-form-section-title">
                Cena i dodatni detalji
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="PricePerDay" class="form-label">
                        Cena iznajmljivanja po danu (RSD)
                    </label>
                    <div class="input-group">
                        <input asp-for="PricePerDay"
                               type="number"
                               step="0.01"
                               class="form-control car-form-input" />
                        <span class="input-group-text car-form-addon">
                            RSD
                        </span>
                    </div>
                    <span asp-validation-for="PricePerDay"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ImageUrl" class="form-label">
                        URL fotografije
                    </label>
                    <input asp-for="ImageUrl"
                           class="form-control car-form-input" />
                    <span asp-validation-for="ImageUrl"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">
                        Opis automobila
                    </label>
                    <textarea asp-for="Description"
                              class="form-control car-form-input"
                              rows="4"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="car-form-actions">
                <a asp-controller="Car"
                   asp-action="Index"
                   class="btn car-cancel-btn">
                    Odustanite
                </a>

                <button type="submit" class="btn car-save-btn">
                    Sačuvajte izmene
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
